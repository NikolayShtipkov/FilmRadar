{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FilmRadar (.NET 10 MVC)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/FilmRadar.Web/bin/Debug/net10.0/FilmRadar.Web.dll",
      "cwd": "${workspaceFolder}/src/FilmRadar.Web",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5133"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/FilmRadar.Web/Views"
      }
    }
  ]
}
